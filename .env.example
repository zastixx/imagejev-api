# ==============================================================================
# ImageJev Production Environment Configuration
# ==============================================================================

# Server Network & Port
PORT=8000
HOST=0.0.0.0

# API Key Protection (comma-separated list of authorized keys)
# If left empty, API key authentication is disabled (development mode)
IMAGEJEV_API_KEYS=sk-live-0123456789abcdef,sk-live-fedcba9876543210

# Rate Limiting (Sliding Window per IP / per API Key)
IMAGEJEV_RATE_LIMIT_ENABLED=true
IMAGEJEV_RATE_LIMIT_PER_MINUTE=60        # Standard /decide and /decide_upload
IMAGEJEV_BATCH_RATE_LIMIT_PER_MINUTE=15  # Batch processing limit

# Safety Caps & DoS Guards
IMAGEJEV_MAX_BATCH_SIZE=50               # Maximum images per /decide_batch request
IMAGEJEV_MAX_QUESTIONS=25                # Maximum questions per /v1/systemone request
IMAGEJEV_MAX_IMAGE_BYTES=10485760        # 10 MB maximum image payload size

# Concurrency Throttling (Limits simultaneous CPU/GPU inference tasks)
IMAGEJEV_MAX_CONCURRENCY=4               # CPU worker bound (prevents thread thrashing)
IMAGEJEV_CONCURRENCY_TIMEOUT=30.0        # Seconds requests will queue before 503

# CORS Configuration (comma-separated domains, e.g. "https://myapp.com,https://dashboard.myapp.com")
IMAGEJEV_ALLOWED_ORIGINS=*
